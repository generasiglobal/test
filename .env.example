# Copy to .env and change the values.

# Product name shown on the landing page (pick your own brand).
NEXT_PUBLIC_BRAND=OrderChat

# Postgres (used by docker compose and the app)
POSTGRES_USER=orderchat
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=orderchat

# The app connects with this URL when running on your laptop with `npm run dev`.
# (Inside docker compose the app uses host "db" instead of "localhost" automatically.)
DATABASE_URL=postgres://orderchat:change-me-to-a-long-random-string@localhost:5432/orderchat

# Secret token for downloading the waitlist as CSV:
#   http://localhost:3000/api/waitlist/export?token=YOUR_TOKEN
ADMIN_TOKEN=change-me-too
